      "manufacturer": "Valve",
      "model": "Steam Deck",
      "sw_version": "deck-ha-bridge 1.0.0"
    },
    "name": "Battery power",
    "device_class": "power",
    "unit_of_measurement": "W",
    "state_class": "measurement",
    "value_template": "{{ value_json.power_w if value_json.power_w is not none else 'None' }}"
  },
