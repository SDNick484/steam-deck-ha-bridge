{
  "homeassistant/sensor/steamdeck/battery/config": {
    "unique_id": "steamdeck_battery",
    "state_topic": "deck-ha-bridge/steamdeck/state",
    "availability_topic": "deck-ha-bridge/steamdeck/availability",
    "device": {
      "identifiers": [
        "deck-ha-bridge-steamdeck"
      ],
      "name": "Steam Deck",
      "manufacturer": "Valve",
      "model": "Steam Deck",
      "sw_version": "deck-ha-bridge 1.0.0"
    },
    "name": "Battery",
    "device_class": "battery",
    "unit_of_measurement": "%",
    "state_class": "measurement",
    "value_template": "{{ value_json.battery if value_json.battery is not none else 'None' }}"
  },
  "homeassistant/sensor/steamdeck/battery_power/config": {
    "unique_id": "steamdeck_battery_power",
    "state_topic": "deck-ha-bridge/steamdeck/state",
